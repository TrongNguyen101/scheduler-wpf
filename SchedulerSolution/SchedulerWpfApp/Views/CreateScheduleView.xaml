<UserControl x:Class="SchedulerWpfApp.Views.CreateScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SchedulerWpfApp.Views"
             mc:Ignorable="d">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Height="40"
              Margin="0,0,0,0">
            <Border Background="{StaticResource PrimaryColor}"
                    CornerRadius="10, 10, 0 , 0">
                <TextBlock Text="Create Schedule"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="center"
                           Padding="0, 0, 0, 0" />
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Controls -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="#EEF2F6"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextColor}"
                                 VerticalAlignment="Center"
                                 Name="SearchBox"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="0,5">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource ExportButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ExportPersonCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Export Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ImportPersonCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Import Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add Person Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding CreateScheduleCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Create lịch"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Filter Controls -->
            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="20,10">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <TextBlock Text="YEAR "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <ComboBox Width="100"
                              ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <TextBlock Text="WEEK "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding Weeks}"
                              SelectedItem="{Binding SelectedWeek}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="CLASS "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding GroupNames}"
                              SelectedItem="{Binding SelectedGroupName}" />
                </StackPanel>
            </StackPanel>

            <!-- Timetable Grid -->
            <ScrollViewer Grid.Row="2"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Header Row -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Cột Slot Label -->
                        <Border Grid.Column="0"
                                Background="#4A90E2"
                                BorderBrush="White"
                                BorderThickness="0,0,1,1"
                                Width="80">
                            <TextBlock Text=""
                                       Padding="5" />
                        </Border>

                        <!-- Các ngày trong tuần chia đều -->
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding WeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#4A90E2"
                                            BorderBrush="White"
                                            BorderThickness="0.5,0,0.5,1">
                                        <TextBlock Text="{Binding StringFormat='{}{0:ddd (dd/MM)}'}"
                                                   Foreground="White"
                                                   FontWeight="Bold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   Padding="5" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Body Rows -->
                    <ItemsControl Grid.Row="1"
                                  ItemsSource="{Binding SlotRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Slot Label -->
                                    <Border Grid.Column="0"
                                            Background="#f0f0f0"
                                            BorderBrush="LightGray"
                                            BorderThickness="0,0,1,1"
                                            Width="80">
                                        <TextBlock Text="{Binding SlotNumber, StringFormat=Slot {0}}"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontWeight="Bold"
                                                   Padding="5" />
                                        <!--<TextBlock Text="{Binding SlotTimeRange}"
                                                   FontSize="11"
                                                   Foreground="Gray" />-->
                                    </Border>

                                    <!-- 7 Cells -->
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="7" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="LightGray"
                                                        BorderThickness="0.5"
                                                        Background="White"
                                                        MinHeight="80">
                                                    <StackPanel Margin="4">
                                                        <TextBlock Text="{Binding Schedule.SubjectCode}"
                                                                   FontWeight="Bold"
                                                                   FontSize="15"
                                                                   Foreground="Black"
                                                                   TextWrapping="Wrap" />

                                                        <TextBlock Text="{Binding Schedule.RoomNo, StringFormat=at {0}}"
                                                                   FontSize="14"
                                                                   Foreground="DarkSlateGray"
                                                                   Margin="0,2,0,0" />

                                                        <TextBlock Text="{Binding Schedule.StatusSlot}"
                                                                   FontSize="14"
                                                                   Foreground="DarkGreen"
                                                                   Margin="0,2,0,0" />

                                                        <TextBlock Text="{Binding Schedule.GroupName }"
                                                                   FontSize="14"
                                                                   Foreground="Gray"
                                                                   Margin="0,2,0,0" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
