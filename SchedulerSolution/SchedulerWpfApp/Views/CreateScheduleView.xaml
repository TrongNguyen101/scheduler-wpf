<UserControl x:Class="SchedulerWpfApp.Views.CreateScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:SchedulerWpfApp.Views"
             mc:Ignorable="d"
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:helper="clr-namespace:SchedulerWpfApp.Helper"
             xmlns:controls="clr-namespace:SchedulerWpfApp.Controls">

    <UserControl.Resources>
        <helper:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <helper:DisplayModeToVisibilityConverter x:Key="DisplayModeToVisibilityConverter" />
        <helper:DisplayModeToBrushConverter x:Key="DisplayModeToBrushConverter" />

        <Style x:Key="TabButtonStyle"
               TargetType="Button">
            <Setter Property="Padding"
                    Value="10,5" />
            <Setter Property="Margin"
                    Value="0,0,10,0" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="White" />
            <Setter Property="BorderBrush"
                    Value="Transparent" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.9" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ScheduleContentStyle"
               TargetType="StackPanel">
            <Setter Property="Visibility"
                    Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Schedule}"
                             Value="{x:Null}">
                    <Setter Property="Visibility"
                            Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EmptySlotStyle"
               TargetType="TextBlock">
            <Setter Property="Visibility"
                    Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Schedule}"
                             Value="{x:Null}">
                    <Setter Property="Visibility"
                            Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Style cho cell khi được drag over -->
        <Style x:Key="DragOverCellStyle"
               TargetType="Border">
            <Setter Property="Background"
                    Value="LightBlue" />
            <Setter Property="BorderBrush"
                    Value="Blue" />
            <Setter Property="BorderThickness"
                    Value="0.5" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragOver}"
                             Value="True">
                    <Setter Property="Background"
                            Value="LightGreen" />
                    <Setter Property="BorderBrush"
                            Value="Green" />
                    <Setter Property="BorderThickness"
                            Value="3" />
                </DataTrigger>

                <DataTrigger Binding="{Binding IsDragSource}"
                             Value="True">
                    <Setter Property="Background"
                            Value="OrangeRed" />
                    <Setter Property="BorderBrush"
                            Value="Brown" />
                    <Setter Property="BorderThickness"
                            Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- DataTemplate cho TimetableCell -->
        <DataTemplate x:Key="TimetableCellTemplate">
            <Border Style="{StaticResource DragOverCellStyle}"
                    MinHeight="60"
                    Margin="1"
                    AllowDrop="True">

                <!-- Drag & Drop Event Handlers -->
                <i:Interaction.Triggers>
                    <i:EventTrigger EventName="MouseDown">
                        <i:InvokeCommandAction Command="{Binding MouseDownCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="MouseMove">
                        <i:InvokeCommandAction Command="{Binding MouseMoveCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragEnter">
                        <i:InvokeCommandAction Command="{Binding DragEnterCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragLeave">
                        <i:InvokeCommandAction Command="{Binding DragLeaveCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="DragOver">
                        <i:InvokeCommandAction Command="{Binding DragOverCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                    <i:EventTrigger EventName="Drop">
                        <i:InvokeCommandAction Command="{Binding DropCommand}"
                                               PassEventArgsToCommand="True" />
                    </i:EventTrigger>
                </i:Interaction.Triggers>

                <!-- Content hiển thị schedule -->
                <Grid>
                    <!-- Empty slot text -->
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="Gray"
                               FontStyle="Italic"
                               Style="{StaticResource EmptySlotStyle}" />

                    <!-- Schedule content -->
                    <StackPanel Margin="5"
                                Style="{StaticResource ScheduleContentStyle}">
                        <TextBlock Text="{Binding Schedule.SubjectCode}"
                                   FontWeight="Bold"
                                   FontSize="12" />
                        <TextBlock Text="{Binding Schedule.LecturerId}"
                                   FontSize="10" />
                        <TextBlock Text="{Binding Schedule.RoomId}"
                                   FontSize="10"
                                   Foreground="Gray" />
                        <TextBlock Text="{Binding Schedule.StatusSlot}"
                                   FontSize="9"
                                   Foreground="DarkBlue" />
                    </StackPanel>

                    <!-- Visual indicator khi đang drag -->
                    <Rectangle Fill="Yellow"
                               Opacity="0.3"
                               Visibility="{Binding IsDragOver, Converter={StaticResource BooleanToVisibilityConverter}}" />

                    <Rectangle Fill="Red"
                               Opacity="0.3"
                               Visibility="{Binding IsDragSource, Converter={StaticResource BooleanToVisibilityConverter}}" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- DataTemplate cho SlotRow -->
        <DataTemplate x:Key="SlotRowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Slot number -->
                <Border Grid.Column="0"
                        Background="LightGray"
                        BorderBrush="Gray"
                        BorderThickness="1"
                        Margin="1">
                    <TextBlock Text="{Binding SlotNumber}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontWeight="Bold" />
                </Border>

                <!-- Cells for each day -->
                <ItemsControl Grid.Column="1"
                              ItemsSource="{Binding Cells}"
                              ItemTemplate="{StaticResource TimetableCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Height="40"
              Margin="0,0,0,0">
            <Border Background="{StaticResource PrimaryColor}"
                    CornerRadius="10, 10, 0 , 0">
                <TextBlock Text="Create Schedule"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="center"
                           Padding="0, 0, 0, 0" />
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Top Controls -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="#EEF2F6"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextColor}"
                                 VerticalAlignment="Center"
                                 Name="SearchBox"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="0,5">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource ExportButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ExportExcelCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Export Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ImportPersonCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Import Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add Person Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding OpenPopupCreateCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Create lịch"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <StackPanel Grid.Row="1"
                        Orientation="Horizontal"
                        Margin="10">
                <Border BorderThickness="2"
                        BorderBrush="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToBrushConverter}, ConverterParameter=CLASS}"
                        CornerRadius="6"
                        Margin="0,0,10,0">
                    <Button Content="Hiển thị theo lớp"
                            Command="{Binding SetDisplayModeCommand}"
                            CommandParameter="CLASS"
                            FontSize="14"
                            Style="{StaticResource ExportButtonStyle}" />
                </Border>

                <Border BorderThickness="2"
                        BorderBrush="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToBrushConverter}, ConverterParameter=ROOM}"
                        CornerRadius="6"
                        Margin="0,0,10,0">
                    <Button Content="Hiển thị theo phòng"
                            Command="{Binding SetDisplayModeCommand}"
                            FontSize="14"
                            CommandParameter="ROOM"
                            Style="{StaticResource ActionButtonStyle}" />
                </Border>

                <Border BorderThickness="2"
                        BorderBrush="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToBrushConverter}, ConverterParameter=LECTURER}"
                        CornerRadius="6"
                        Margin="0,0,10,0">
                    <Button Content="Hiển thị theo giảng viên"
                            Command="{Binding SetDisplayModeCommand}"
                            FontSize="14"
                            CommandParameter="LECTURER"
                            Style="{StaticResource SuccessButtonStyle}" />
                </Border>

            </StackPanel>

            <!-- Filter Controls -->
            <StackPanel Grid.Row="
                        2"
                        Orientation="
                        Horizontal"
                        Margin="20,10">
                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <TextBlock Text="YEAR "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <ComboBox Width="100"
                              IsEditable="True"
                              ItemsSource="{Binding Years}"
                              SelectedItem="{Binding SelectedYear}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,0,10,0">
                    <TextBlock Text="WEEK "
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <ComboBox Width="150"
                              IsEditable="True"
                              ItemsSource="{Binding Weeks}"
                              SelectedItem="{Binding SelectedWeek}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding CurrentDisplayMode}"
                               VerticalAlignment="Center"
                               Margin="0,0,5,0" />
                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,10,0">
                        <!-- ComboBox class -->
                        <ComboBox ItemsSource="{Binding GroupNames}"
                                  SelectedItem="{Binding SelectedGroupName}"
                                  Width="150"
                                  IsEditable="True"
                                  Margin="0,0,10,0"
                                  Visibility="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToVisibilityConverter}, ConverterParameter=CLASS}" />

                        <!-- ComboBox room -->
                        <ComboBox ItemsSource="{Binding Rooms}"
                                  SelectedItem="{Binding SelectedRoom}"
                                  Width="150"
                                  IsEditable="True"
                                  Visibility="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToVisibilityConverter}, ConverterParameter=ROOM}" />

                        <!-- ComboBox lecturer -->
                        <ComboBox ItemsSource="{Binding Lecturers}"
                                  SelectedItem="{Binding SelectedLecturer}"
                                  Width="150"
                                  IsEditable="True"
                                  Visibility="{Binding CurrentDisplayMode, Converter={StaticResource DisplayModeToVisibilityConverter}, ConverterParameter=LECTURER}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Timetable Grid -->
            <ScrollViewer Grid.Row="3"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto"
                          Background="#FAFBFC">
                <StackPanel>
                    <!-- Day headers with enhanced styling -->
                    <Grid Margin="61,0,0,0"
                          Effect="{x:Null}">
                        <ItemsControl ItemsSource="{Binding WeekDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="DarkBlue"
                                            BorderBrush="#E3E8ED"
                                            BorderThickness="1"
                                            Margin="1"
                                            CornerRadius="8,8,0,0">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Margin="8,10">
                                            <TextBlock Text="{Binding Path=., StringFormat='{}{0:ddd}'}"
                                                       Foreground="White"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding Path=., StringFormat='{}{0:dd/MM}'}"
                                                       Foreground="White"
                                                       FontSize="12"
                                                       FontWeight="Bold"
                                                       HorizontalAlignment="Center"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>

                    <!-- Slot rows with enhanced styling -->
                    <ItemsControl ItemsSource="{Binding SlotRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="60" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Enhanced Slot number styling -->
                                    <Border Grid.Column="0"
                                            Background="#4A90E2"
                                            BorderBrush="#DEE2E6"
                                            BorderThickness="1"
                                            Margin="1"
                                            CornerRadius="6,0,0,6">
                                        <StackPanel HorizontalAlignment="Center"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding SlotNumber, StringFormat=Slot {0}}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       FontWeight="Bold"
                                                       Foreground="White"
                                                       Padding="5" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Enhanced Cells for each day -->
                                    <ItemsControl Grid.Column="1"
                                                  ItemsSource="{Binding Cells}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="#E3E8ED"
                                                        BorderThickness="1"
                                                        Background="White"
                                                        MinHeight="70"
                                                        Margin="1"
                                                        CornerRadius="0,6,6,0"
                                                        AllowDrop="True">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Effect">
                                                                <Setter.Value>
                                                                    <DropShadowEffect Color="#000000"
                                                                                      Direction="270"
                                                                                      ShadowDepth="1"
                                                                                      BlurRadius="3"
                                                                                      Opacity="0.08" />
                                                                </Setter.Value>
                                                            </Setter>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Schedule}"
                                                                             Value="{x:Null}">
                                                                    <Setter Property="Background"
                                                                            Value="#F8F9FA" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#DEE2E6" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDragOver}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#D4EDDA" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#28A745" />
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding IsDragSource}"
                                                                             Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#F8D7DA" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#DC3545" />
                                                                    <Setter Property="BorderThickness"
                                                                            Value="2" />
                                                                </DataTrigger>
                                                                <Trigger Property="IsMouseOver"
                                                                         Value="True">
                                                                    <Setter Property="Background"
                                                                            Value="#E7F3FF" />
                                                                    <Setter Property="BorderBrush"
                                                                            Value="#0066CC" />
                                                                    <Setter Property="Cursor"
                                                                            Value="Hand" />
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>

                                                    <!-- Drag & Drop Event Handlers -->
                                                    <i:Interaction.Triggers>
                                                        <i:EventTrigger EventName="MouseDown">
                                                            <i:InvokeCommandAction Command="{Binding MouseDownCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseMove">
                                                            <i:InvokeCommandAction Command="{Binding MouseMoveCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="DragEnter">
                                                            <i:InvokeCommandAction Command="{Binding DragEnterCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="DragLeave">
                                                            <i:InvokeCommandAction Command="{Binding DragLeaveCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="DragOver">
                                                            <i:InvokeCommandAction Command="{Binding DragOverCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="Drop">
                                                            <i:InvokeCommandAction Command="{Binding DropCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                        <i:EventTrigger EventName="MouseLeftButtonDown">
                                                            <i:InvokeCommandAction Command="{Binding EditScheduleCommand}"
                                                                                   PassEventArgsToCommand="True" />
                                                        </i:EventTrigger>
                                                    </i:Interaction.Triggers>

                                                    <!-- Content Grid -->
                                                    <Grid>
                                                        <!-- Empty slot indicator -->
                                                        <StackPanel HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Schedule}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>
                                                            <TextBlock Text="-"
                                                                       FontSize="16"
                                                                       HorizontalAlignment="Center"
                                                                       Opacity="0.4" />
                                                        </StackPanel>

                                                        <!-- Schedule content with enhanced styling -->
                                                        <StackPanel Margin="8,6">
                                                            <StackPanel.Style>
                                                                <Style TargetType="StackPanel">
                                                                    <Setter Property="Visibility"
                                                                            Value="Visible" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Schedule}"
                                                                                     Value="{x:Null}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </StackPanel.Style>

                                                            <TextBlock Text="{Binding Schedule.SubjectCode}"
                                                                       HorizontalAlignment="Center"
                                                                       FontWeight="Bold"
                                                                       FontSize="14"
                                                                       Foreground="#1A1A1A"
                                                                       TextWrapping="Wrap"
                                                                       LineHeight="16" />

                                                            <StackPanel HorizontalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Margin="0,3,0,0">
                                                                <TextBlock Text="👨‍🏫"
                                                                           FontSize="10"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,3,0" />
                                                                <TextBlock Text="{Binding Schedule.LecturerName}"
                                                                           FontSize="12"
                                                                           Foreground="#495057"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <StackPanel HorizontalAlignment="Center"
                                                                        Orientation="Horizontal"
                                                                        Margin="0,2,0,0">
                                                                <TextBlock Text="🏫"
                                                                           FontSize="11"
                                                                           VerticalAlignment="Center"
                                                                           Margin="0,0,3,0" />
                                                                <TextBlock Text="{Binding Schedule.RoomName}"
                                                                           FontSize="13"
                                                                           Foreground="#6C757D"
                                                                           VerticalAlignment="Center" />
                                                            </StackPanel>

                                                            <Border Background="#5cb85c"
                                                                    CornerRadius="3"
                                                                    Padding="4,2"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding SlotTime}"
                                                                           FontSize="15"
                                                                           FontWeight="Medium"
                                                                           Foreground="White" />
                                                            </Border>

                                                            <Border Background="#E8F5E8"
                                                                    CornerRadius="3"
                                                                    Padding="4,2"
                                                                    Margin="0,4,0,0"
                                                                    HorizontalAlignment="Center">
                                                                <TextBlock Text="{Binding Schedule.StatusSlot}"
                                                                           FontSize="15"
                                                                           FontWeight="Medium"
                                                                           Foreground="#155724" />
                                                            </Border>
                                                        </StackPanel>

                                                        <!-- Drag indicators with smooth animations -->
                                                        <Border Background="#FFF3CD"
                                                                BorderBrush="#FFEAA7"
                                                                BorderThickness="2"
                                                                CornerRadius="4"
                                                                Opacity="0.9">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDragOver}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#856404" />
                                                        </Border>

                                                        <Border Background="#F5C6CB"
                                                                BorderBrush="#F1B0B7"
                                                                BorderThickness="2"
                                                                CornerRadius="4"
                                                                Opacity="0.8">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility"
                                                                            Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsDragSource}"
                                                                                     Value="True">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <TextBlock FontWeight="Bold"
                                                                       FontSize="12"
                                                                       Foreground="#721C24" />
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Popup x:Name="EditScheduleFormPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsEditScheduleFormOpen}"
               AllowsTransparency="True">
            <Border Background="#F0F4F8"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="25"
                    Width="500">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="15"
                                      Opacity="0.2"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">
                        <TextBlock x:Name="formTitle"
                                   Text="Chỉnh sửa lịch học"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" />
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,20">
                        <TextBlock Text="Mã môn học"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <TextBox Text="{Binding EditingSchedule.SubjectCode}"
                                 IsEnabled="False" />
                        <TextBlock Text="Tên phòng học"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />
                        <ComboBox ItemsSource="{Binding ListRooms}"
                                  SelectedItem="{Binding SelectedRoom, Mode=TwoWay}"
                                  DisplayMemberPath="RoomName" />

                        <TextBlock Text="Giảng viên"
                                   FontWeight="Bold"
                                   Margin="10,10,0,5" />
                        <ComboBox ItemsSource="{Binding LecturerSubjects}"
                                  SelectedItem="{Binding SelectedLecturer, Mode=TwoWay}"
                                  DisplayMemberPath="LecturerName" />

                        <TextBlock Text="Trạng thái"
                                   FontWeight="Bold"
                                   Margin="10,10,0,5" />
                        <ComboBox ItemsSource="{Binding SlotStatusList}"
                                  SelectedItem="{Binding EditingSchedule.StatusSlot, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Form Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Hủy"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#95a5a6"
                                Margin="0,0,10,0"
                                Padding="20,8"
                                Command="{Binding CancelEditScheduleCommand}" />

                        <Button Grid.Column="2"
                                x:Name="btnSaveLecturer"
                                Content="Lưu"
                                Style="{StaticResource SuccessButtonStyle}"
                                Padding="20,8"
                                Command="{Binding UpdateScheduleCommand}" />
                    </Grid>
                </Grid>
              </Border>
        </Popup>
   
        <Popup x:Name="ScheduleFormPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsScheduleFormOpen}"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="#F0F4F8"
                    BorderBrush="#DDD"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="20"
                    Width="520"
                    SnapsToDevicePixels="True">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="15"
                                      ShadowDepth="2"
                                      Opacity="0.2" />
                </Border.Effect>

                <StackPanel>
                    <!-- Tiêu đề -->
                    <TextBlock Text="Chọn chuyên ngành ghép buổi"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="#2c3e50"
                               Margin="0,0,0,20"
                               TextAlignment="Center" />

                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Chọn ngày bắt đầu lịch"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"
                                   Foreground="#333" />
                        <DatePicker SelectedDate="{Binding SelectedDate, Mode=TwoWay}"
                                    Language="vi-VN">
                            <DatePicker.Resources>
                                <Style TargetType="DatePickerTextBox">
                                    <Setter Property="IsReadOnly"
                                            Value="True" />
                                </Style>
                            </DatePicker.Resources>
                        </DatePicker>

                    </StackPanel>
                    <!-- Major first -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Nhóm chuyên ngành A"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"
                                   Foreground="#333" />

                        <!-- Tag -->
                        <ItemsControl ItemsSource="{Binding MajorFirstList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#e0f7fa"
                                            BorderBrush="#00acc1"
                                            BorderThickness="1"
                                            Margin="3"
                                            Padding="6,4"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       Foreground="#007c91" />
                                            <Button Content="x"
                                                    FontSize="10"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="5,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="Gray"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveMajorFirstItemCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:ComboBoxTemplate ItemsSource="{Binding FilteredMajorFirst}"
                                                   SelectedItem="{Binding SelectedMajorFirstCombo, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Major second -->
                    <StackPanel Margin="0,0,0,20">
                        <TextBlock Text="Nhóm chuyên ngành B"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5"
                                   Foreground="#333" />

                        <ItemsControl ItemsSource="{Binding MajorSecondList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#f1f8e9"
                                            BorderBrush="#8bc34a"
                                            BorderThickness="1"
                                            Margin="3"
                                            Padding="6,4"
                                            CornerRadius="8">
                                        <StackPanel Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="12"
                                                       Foreground="#558b2f" />
                                            <Button Content="x"
                                                    FontSize="10"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="5,0,0,0"
                                                    Padding="0"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Foreground="Gray"
                                                    Cursor="Hand"
                                                    Command="{Binding DataContext.RemoveMajorSecondItemCommand, RelativeSource={RelativeSource AncestorType=Popup}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <controls:ComboBoxTemplate ItemsSource="{Binding FilteredMajorSecond}"
                                                   SelectedItem="{Binding SelectedMajorSecondCombo, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- Action buttons -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Hủy"
                                Command="{Binding CancelCreateScheduleCommand}"
                                Margin="0,0,10,0"
                                Padding="12,6"
                                Background="#bdc3c7"
                                Foreground="White"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Content="Tạo"
                                Command="{Binding CreateScheduleCommand}"
                                Padding="12,6"
                                Background="#3498db"
                                Foreground="White"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </StackPanel
            </Border>
        </Popup>
    </Grid>
</UserControl>
