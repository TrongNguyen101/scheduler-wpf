<UserControl x:Class="SchedulerWpfApp.Views.LecturerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SchedulerWpfApp.ViewModel"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
             Background="White">

    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Background="{StaticResource PrimaryColor}" Height="50" Margin="20" Width="500" HorizontalAlignment="Left">
            <TextBlock Text="Quản Lí Lớp Học" FontWeight="Bold" FontSize="22" Foreground="White" VerticalAlignment="Center" HorizontalAlignment="Left" Padding="10, 0, 0, 0" />
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="#EEF2F6" BorderBrush="#D0D0D0" BorderThickness="1" CornerRadius="6" Padding="10,5" Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍" FontSize="14" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Margin="8,0,0,0" BorderThickness="0" Background="Transparent" Foreground="{StaticResource TextColor}" VerticalAlignment="Center" Name="SearchBox"  Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}" Padding="0,5">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer x:Name="PART_ContentHost" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
        Style="{StaticResource ExportButtonStyle}"
        Margin="0,0,10,0"
        Command="{Binding ExportStudentCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤" VerticalAlignment="Center" />
                        <TextBlock Text=" Export Dữ Liệu" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="2" Style="{StaticResource ActionButtonStyle}" Margin="0,0,10,0" Command="{Binding ImportStudentCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥" VerticalAlignment="Center" />
                        <TextBlock Text=" Import Dữ Liệu" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add Student Button -->
                <Button Grid.Column="3" Style="{StaticResource SuccessButtonStyle}" Command="{Binding AddStudentCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕" VerticalAlignment="Center" />
                        <TextBlock Text=" Thêm Môn Học" Margin="5,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Syncfusion DataGrid -->
            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1" BlurRadius="10" Opacity="0.1" Color="Gray" />
                </Border.Effect>

                <syncfusion:SfDataGrid x:Name="studentsDataGrid" AutoGenerateColumns="False" AllowFiltering="True" ShowRowHeader="False" RowHeight="45" HeaderRowHeight="50" SelectionMode="Single" AllowSorting="True" GridLinesVisibility="Both" ItemsSource="{Binding Students}" ColumnSizer="Star" HeaderStyle="{StaticResource GridHeaderStyle}" CellStyle="{StaticResource GridCellStyle}">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="Mã Lớp Học" MappingName="StudentId" />
                        <syncfusion:GridTextColumn HeaderText="Tên Lớp" MappingName="FullName" />
                        <syncfusion:GridTextColumn HeaderText="Số Học Sinh" MappingName="Email" />
                        <syncfusion:GridTextColumn HeaderText="Số Giảng Viên" MappingName="Phone" />
                        <syncfusion:GridTemplateColumn HeaderText="Actions" Width="180">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Button Style="{StaticResource EditButtonStyle}" Padding="10,5" Margin="0,0,5,0"  Command="{Binding EditStudentCommand}"
        CommandParameter="{Binding StudentId}">
                                            <TextBlock Text="✏️ Sửa" />
                                        </Button>
                                        <Button Style="{StaticResource DeleteButtonStyle}" Padding="10,5" Command="{Binding DeleteStudentCommand}">
                                            <TextBlock Text="🗑️ Xóa" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Border>

            <!-- Pagination Controls -->
            <Grid Grid.Row="2" Margin="0,15,0,0" HorizontalAlignment="Right" Width="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pagination -->
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <syncfusion:SfDataPager x:Name="dataPager" PageSize="10" NumericButtonCount="5" PagedSource="{Binding Students}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Student Form Popup -->
        <Popup x:Name="studentFormPopup" StaysOpen="False" Placement="Center" IsOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderThickness="0" CornerRadius="8" Padding="25" Width="500">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="15" Opacity="0.2" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,20">
                        <TextBlock x:Name="formTitle" Text="Thêm Sinh Viên Mới" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextColor}" />
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Mã sinh viên" Margin="0,0,0,5" Foreground="{StaticResource TextColor}" />
                        <TextBox x:Name="txtStudentId" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" />

                        <TextBlock Text="Họ tên" Margin="0,0,0,5" Foreground="{StaticResource TextColor}" />
                        <TextBox x:Name="txtFullName" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" />

                        <TextBlock Text="Email" Margin="0,0,0,5" Foreground="{StaticResource TextColor}" />
                        <TextBox x:Name="txtEmail" Style="{StaticResource ModernTextBoxStyle}" Margin="0,0,0,15" />

                        <TextBlock Text="Số điện thoại" Margin="0,0,0,5" Foreground="{StaticResource TextColor}" />
                        <TextBox x:Name="txtPhone" Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>

                    <!-- Form Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="Hủy" Style="{StaticResource ActionButtonStyle}" Background="#95a5a6" Margin="0,0,10,0" Padding="20,8" Command="{Binding EditStudentCommand}" />

                        <Button Grid.Column="2" x:Name="btnSaveStudent" Content="Lưu" Style="{StaticResource SuccessButtonStyle}" Padding="20,8" Command="{Binding SaveStudentCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- Confirmation Dialog -->
        <Popup x:Name="confirmationPopup" StaysOpen="False" Placement="Center" IsOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderThickness="0" CornerRadius="8" Padding="25" Width="400">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2" BlurRadius="15" Opacity="0.2" Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <TextBlock Grid.Row="0" Text="Xác nhận xóa" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextColor}" Margin="0,0,0,15" />

                    <!-- Dialog Content -->
                    <TextBlock Grid.Row="1" Text="Bạn có chắc chắn muốn xóa sinh viên này không?" TextWrapping="Wrap" Foreground="{StaticResource TextColor}" Margin="0,0,0,20" />

                    <!-- Dialog Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1" Content="Hủy" Style="{StaticResource ActionButtonStyle}" Background="#95a5a6" Margin="0,0,10,0" Padding="20,8" Command="{Binding SaveStudentCommand}" />

                        <Button Grid.Column="2" Content="Xóa" Style="{StaticResource DeleteButtonStyle}" Padding="20,8" Command="{Binding ConfirmDeleteStudentCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
