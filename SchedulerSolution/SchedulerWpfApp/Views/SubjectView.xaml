<UserControl x:Class="SchedulerWpfApp.Views.SubjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SchedulerWpfApp.ViewModel"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             Background="White">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Height="40"
              Margin="0,0,0,0">
            <Border Background="{StaticResource PrimaryColor}"
                    CornerRadius="10, 10, 0 , 0">
                <TextBlock Text="Quản Lý Môn Học"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="center"
                           Padding="0, 0, 0, 0" />
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Controls -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="#EEF2F6"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextColor}"
                                 VerticalAlignment="Center"
                                 Name="SearchBox"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="0,5">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource ExportButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ExportSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Export Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ImportSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Import Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add Student Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding AddSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Thêm Môn Học"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Import Template Notice -->
            <Border Grid.Row="1" Background="#FFF3CD" BorderBrush="#FFEAA7" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,15">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="ℹ️" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="Template import: " FontSize="14" VerticalAlignment="Center" Foreground="#856404" />
                    <TextBlock Text="SubjectCode, SubjectNameEnglish, SubjectNameVietnamese, TotalTime, TotalCredits" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="#856404" />
                </StackPanel>
            </Border>

            <!-- Syncfusion DataGrid -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="8"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1"
                                      BlurRadius="10"
                                      Opacity="0.1"
                                      Color="Gray" />
                </Border.Effect>

                <syncfusion:SfDataGrid x:Name="SubjectsDataGrid"
                                       AutoGenerateColumns="False"
                                       AllowFiltering="True"
                                       ShowRowHeader="False"
                                       RowHeight="45"
                                       HeaderRowHeight="50"
                                       SelectionMode="Single"
                                       AllowSorting="True"
                                       GridLinesVisibility="Both"
                                       ItemsSource="{Binding ElementName=dataPager,Path=PagedSource}"
                                       ColumnSizer="Star"
                                       HeaderStyle="{StaticResource GridHeaderStyle}"
                                       CellStyle="{StaticResource GridCellStyle}"
                                       CurrentCellBorderBrush="White">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="Mã Môn Học"
                                                   MappingName="SubjectCode"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tên Tiếng Anh"
                                                   MappingName="SubjectNameEnglish"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tên Tiếng Việt"
                                                   MappingName="SubjectNameVietnamese"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Thời Gian Học"
                                                   MappingName="TotalTime"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tổng Tín Chỉ"
                                                   MappingName="TotalCredits"
                                                   AllowResizing="True" />
                        <syncfusion:GridTemplateColumn HeaderText="Actions"
                                                       Width="90"
                                                       AllowFiltering="False"
                                                       MappingName="ActionPlaceholder">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Command="{Binding DataContext.EditSubjectCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="✏️"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Command="{Binding DataContext.DeleteSubjectCommand,  RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="🗑️"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Border>

            <!-- Pagination Controls -->
            <Grid Grid.Row="3"
                  Margin="0,15,0,0"
                  HorizontalAlignment="Right"
                  Width="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pagination -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <syncfusion:SfDataPager x:Name="dataPager"
                                            PageSize="50"
                                            NumericButtonCount="5"
                                            Source="{Binding Subjects}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- Subject Form Popup -->
        <Popup x:Name="SubjectFormPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsSubjectFormOpen}"
               AllowsTransparency="True">
            <Border Background="#F0F4F8"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="25"
                    Width="500">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="15"
                                      Opacity="0.2"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">
                        <TextBlock x:Name="formTitle"
                                   Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" />
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,20">
                        <TextBlock Text="Mã Môn học"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.SubjectCode}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="{Binding IsSubjectCodeEdit}"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="Tên Tiếng Anh"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.SubjectNameEnglish, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="Tên Tiếng Việt"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.SubjectNameVietnamese, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="Thời Gian Học"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.TotalTime, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntToStringConverter}}"
                                 Style="{StaticResource ModernTextBoxStyle}" />

                        <TextBlock Text="Tổng Tín Chỉ"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.TotalCredits, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource IntToStringConverter}}"
                                 Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>

                    <!-- Form Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Hủy"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#95a5a6"
                                Margin="0,0,10,0"
                                Padding="20,8"
                                Command="{Binding CancelEditSubjectCommand}" />

                        <Button Grid.Column="2"
                                x:Name="btnSaveStudent"
                                Content="Lưu"
                                Style="{StaticResource SuccessButtonStyle}"
                                Padding="20,8"
                                Command="{Binding SaveSubjectCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- Confirmation Dialog -->
        <Popup x:Name="confirmationPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsOpenDialog}"
               AllowsTransparency="True">
            <Border Background="#F0F4F8"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="25"
                    Width="400">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="15"
                                      Opacity="0.2"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <TextBlock Grid.Row="0"
                               Text="Xác nhận xóa"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,0,0,15" />

                    <!-- Dialog Content -->
                    <TextBlock Grid.Row="1"
                               Text="Bạn có chắc chắn muốn xóa môn học này không?"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,0,0,20" />

                    <!-- Dialog Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Hủy"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#95a5a6"
                                Margin="0,0,10,0"
                                Padding="20,8"
                                Command="{Binding CancelDeleteSubjectCommand}" />

                        <Button Grid.Column="2"
                                Content="Xóa"
                                Style="{StaticResource DeleteButtonStyle}"
                                Padding="20,8"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
        <Popup IsOpen="{Binding IsProgressBarOpen}" StaysOpen="True" Placement="Center" AllowsTransparency="True">
            <Border Background="#CCFFFFFF" Padding="20" CornerRadius="8" 
             BorderBrush="Gray" BorderThickness="1" >
                <StackPanel>
                    <TextBlock Text="Đang import dữ liệu vào phần mềm, xin vui lòng chờ..." Margin="0,0,0,8" HorizontalAlignment="Center"/>
                    <ProgressBar Height="24" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Width="300"/>
                </StackPanel>
            </Border>
        </Popup>  
    </Grid>
</UserControl>
