<UserControl x:Class="SchedulerWpfApp.Views.ProcessBar" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:SchedulerWpfApp.Views" mc:Ignorable="d" d:DesignHeight="200" d:DesignWidth="600">
    <!-- Main Container -->
    <Border Background="{StaticResource MainBackgroundGradient}" BorderBrush="{StaticResource BorderLight}" BorderThickness="2" CornerRadius="20" Padding="40" Width="500" MinHeight="180" Margin="50,15,50,15">
        <Border.Effect>
            <DropShadowEffect Color="#000000" BlurRadius="25" ShadowDepth="8" Opacity="0.12" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="20" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="25" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Progress Message -->
            <TextBlock Grid.Row="0" Text="{Binding ProgressMessage}" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" TextWrapping="Wrap" />

            <!-- Progress Bar -->
            <ProgressBar Grid.Row="2" Height="30" Minimum="0" Maximum="100" Value="{Binding ProgressValue}" Style="{StaticResource ProfessionalProgressBar}" HorizontalAlignment="Stretch" />

            <!-- Progress Percentage -->
            <TextBlock Grid.Row="4" Text="{Binding ProgressValue, StringFormat={}{0:F0}%}" FontSize="18" FontWeight="Medium" HorizontalAlignment="Center" Foreground="{StaticResource TextSecondary}" />

            <!-- Cancel Button -->
            <Button Grid.Row="6" Content="HỦY" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Style="{StaticResource ProfessionalCancelButton}" Cursor="Hand" MinWidth="120" />
        </Grid>
    </Border>
</UserControl>