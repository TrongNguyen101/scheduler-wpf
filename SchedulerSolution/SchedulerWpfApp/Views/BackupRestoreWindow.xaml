<Window x:Class="SchedulerWpfApp.Views.BackupRestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Database Backup &amp; Restore"
        Height="700"
        Width="900"
        MinHeight="600"
        MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Icon="/Images/Logo/Schedule.png">

        <Window.Resources>
                <!-- Converters -->
                <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

                <!-- Styles -->
                <Style x:Key="HeaderTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="16"/>
                        <Setter Property="FontWeight"
                                Value="Bold"/>
                        <Setter Property="Margin"
                                Value="0,0,0,10"/>
                        <Setter Property="Foreground"
                                Value="#2C3E50"/>
                </Style>

                <Style x:Key="InfoTextStyle"
                       TargetType="TextBlock">
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="Foreground"
                                Value="#7F8C8D"/>
                        <Setter Property="Margin"
                                Value="0,0,0,5"/>
                </Style>

                <Style x:Key="ActionButtonStyle"
                       TargetType="Button">
                        <Setter Property="Padding"
                                Value="15,8"/>
                        <Setter Property="Margin"
                                Value="5"/>
                        <Setter Property="FontSize"
                                Value="12"/>
                        <Setter Property="FontWeight"
                                Value="SemiBold"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="Cursor"
                                Value="Hand"/>
                        <Style.Triggers>
                                <Trigger Property="IsEnabled"
                                         Value="False">
                                        <Setter Property="Opacity"
                                                Value="0.5"/>
                                </Trigger>
                        </Style.Triggers>
                </Style>

                <Style x:Key="PrimaryButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource ActionButtonStyle}">
                        <Setter Property="Background"
                                Value="#3498DB"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#2980B9"/>
                </Style>

                <Style x:Key="DangerButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource ActionButtonStyle}">
                        <Setter Property="Background"
                                Value="#E74C3C"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#C0392B"/>
                </Style>

                <Style x:Key="SecondaryButtonStyle"
                       TargetType="Button"
                       BasedOn="{StaticResource ActionButtonStyle}">
                        <Setter Property="Background"
                                Value="#95A5A6"/>
                        <Setter Property="Foreground"
                                Value="White"/>
                        <Setter Property="BorderBrush"
                                Value="#7F8C8D"/>
                </Style>

                <Style x:Key="ProgressBarStyle"
                       TargetType="ProgressBar">
                        <Setter Property="Height"
                                Value="20"/>
                        <Setter Property="Margin"
                                Value="0,5"/>
                        <Setter Property="BorderThickness"
                                Value="1"/>
                        <Setter Property="BorderBrush"
                                Value="#BDC3C7"/>
                </Style>
        </Window.Resources>

        <Grid Margin="20">
                <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header Section -->
                <StackPanel Grid.Row="0"
                            Margin="0,0,0,20">
                        <TextBlock Text="Database Backup &amp; Restore - Server Storage"
                                   Style="{StaticResource HeaderTextStyle}"
                                   FontSize="20"/>
                        <TextBlock Style="{StaticResource InfoTextStyle}">
                <Run Text="Current User: "/>
                <Run Text="{Binding CurrentUser, Mode=OneWay}"
                                FontWeight="SemiBold"/>
                        </TextBlock>
                        <TextBlock Text="{Binding BackupCountText}"
                                   Style="{StaticResource InfoTextStyle}"/>
                        <TextBlock Text="All backups are securely stored on the server and can be accessed from any location."
                                   Style="{StaticResource InfoTextStyle}"
                                   FontStyle="Italic"/>
                </StackPanel>

                <!-- Main Content -->
                <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Backup List Section -->
                        <GroupBox Grid.Column="0"
                                  Header="Server Backups"
                                  Margin="0,0,10,0">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>

                                        <!-- Refresh Button -->
                                        <Button Grid.Row="0"
                                                Content="🔄 Refresh from Server"
                                                Command="{Binding RefreshBackupsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,10"/>

                                        <!-- Backup List -->
                                        <DataGrid Grid.Row="1"
                                                  ItemsSource="{Binding AvailableBackups}"
                                                  SelectedItem="{Binding SelectedBackup}"
                                                  AutoGenerateColumns="False"
                                                  IsReadOnly="True"
                                                  SelectionMode="Single"
                                                  GridLinesVisibility="Horizontal"
                                                  HeadersVisibility="Column"
                                                  AlternatingRowBackground="#F8F9FA">

                                                <DataGrid.Columns>
                                                        <DataGridTextColumn Header="Filename"
                                                                            Binding="{Binding Filename}"
                                                                            Width="*"
                                                                            MinWidth="200"/>
                                                        <DataGridTextColumn Header="Upload Date"
                                                                            Binding="{Binding FormattedDate}"
                                                                            Width="140"/>
                                                        <DataGridTextColumn Header="Size"
                                                                            Binding="{Binding FormattedSize}"
                                                                            Width="80"/>
                                                </DataGrid.Columns>

                                                <DataGrid.RowStyle>
                                                        <Style TargetType="DataGridRow">
                                                                <Setter Property="Cursor"
                                                                        Value="Hand"/>
                                                                <Style.Triggers>
                                                                        <Trigger Property="IsMouseOver"
                                                                                 Value="True">
                                                                                <Setter Property="Background"
                                                                                        Value="#ECF0F1"/>
                                                                        </Trigger>
                                                                </Style.Triggers>
                                                        </Style>
                                                </DataGrid.RowStyle>
                                        </DataGrid>

                                        <!-- Loading Indicator -->
                                        <StackPanel Grid.Row="1"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Center"
                                                    Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ProgressBar IsIndeterminate="True"
                                                             Width="200"
                                                             Height="20"
                                                             Margin="0,0,0,10"/>
                                                <TextBlock Text="Loading server backups..."
                                                           HorizontalAlignment="Center"
                                                           Style="{StaticResource InfoTextStyle}"/>
                                        </StackPanel>
                                </Grid>
                        </GroupBox>

                        <!-- Splitter -->
                        <GridSplitter Grid.Column="1"
                                      Width="5"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"
                                      Background="#BDC3C7"/>

                        <!-- Actions Section -->
                        <GroupBox Grid.Column="2"
                                  Header="Actions"
                                  Margin="10,0,0,0">
                                <StackPanel>

                                        <!-- Create Backup Section -->
                                        <Border BorderBrush="#BDC3C7"
                                                BorderThickness="1"
                                                Padding="15"
                                                Margin="0,0,0,15"
                                                CornerRadius="5">
                                                <StackPanel>
                                                        <TextBlock Text="Tạo lịch sử"
                                                                   Style="{StaticResource HeaderTextStyle}"
                                                                   FontSize="14"/>
                                                        <TextBlock Text="Creates a backup of your current database and uploads it to the server for safe storage."
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource InfoTextStyle}"
                                                                   Margin="0,0,0,10"/>

                                                        <Button Content="☁️ Create Server Backup"
                                                                Command="{Binding CreateBackupCommand}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                HorizontalAlignment="Stretch"/>

                                                        <!-- Backup Progress -->
                                                        <StackPanel Visibility="{Binding IsBackupInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Margin="0,10,0,0">
                                                                <TextBlock Text="{Binding BackupProgress.CurrentOperation}"
                                                                           FontSize="11"
                                                                           Margin="0,0,0,5"/>
                                                                <ProgressBar Value="{Binding BackupProgress.PercentComplete}"
                                                                             Maximum="100"
                                                                             Style="{StaticResource ProgressBarStyle}"/>
                                                                <TextBlock Text="{Binding BackupProgress.Status}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#7F8C8D"/>
                                                        </StackPanel>
                                                </StackPanel>
                                        </Border>

                                        <!-- Local Backup Section --><!--
                                        <Border BorderBrush="#27AE60"
                                                BorderThickness="1"
                                                Padding="15"
                                                Margin="0,0,0,15"
                                                CornerRadius="5">
                                                <StackPanel>
                                                        <TextBlock Text="Create Local Backup"
                                                                   Style="{StaticResource HeaderTextStyle}"
                                                                   FontSize="14"/>
                                                        <TextBlock Text="Creates a local backup file using VACUUM INTO. Fast and reliable for local storage."
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource InfoTextStyle}"
                                                                   Margin="0,0,0,10"/>

                                                        <Button Content="💾 Create Local Backup"
                                                                Command="{Binding CreateLocalBackupCommand}"
                                                                Style="{StaticResource ActionButtonStyle}"
                                                                HorizontalAlignment="Stretch"
                                                                Background="#27AE60"
                                                                Foreground="White"/>
                                                </StackPanel>
                                        </Border>-->

                                        <!-- Restore Backup Section -->
                                        <Border BorderBrush="#BDC3C7"
                                                BorderThickness="1"
                                                Padding="15"
                                                Margin="0,0,0,15"
                                                CornerRadius="5">
                                                <StackPanel>
                                                        <TextBlock Text="Restore from Backup"
                                                                   Style="{StaticResource HeaderTextStyle}"
                                                                   FontSize="14"/>
                                                        <TextBlock Text="Restores your database from the selected backup. A safety backup will be created first."
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource InfoTextStyle}"
                                                                   Margin="0,0,0,10"/>

                                                        <Button Content="🔄 Restore Database"
                                                                Command="{Binding RestoreBackupCommand}"
                                                                Style="{StaticResource PrimaryButtonStyle}"
                                                                HorizontalAlignment="Stretch"/>

                                                        <!-- Restore Progress -->
                                                        <StackPanel Visibility="{Binding IsRestoreInProgress, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                                    Margin="0,10,0,0">
                                                                <TextBlock Text="{Binding RestoreProgress.CurrentOperation}"
                                                                           FontSize="11"
                                                                           Margin="0,0,0,5"/>
                                                                <ProgressBar Value="{Binding RestoreProgress.PercentComplete}"
                                                                             Maximum="100"
                                                                             Style="{StaticResource ProgressBarStyle}"/>
                                                                <TextBlock Text="{Binding RestoreProgress.Status}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#7F8C8D"/>
                                                                <!-- Validation Message -->
                                                                <TextBlock Text="{Binding RestoreProgress.ValidationMessage}"
                                                                           FontSize="10"
                                                                           HorizontalAlignment="Center"
                                                                           Foreground="#E67E22"
                                                                           Visibility="{Binding RestoreProgress.IsValidating, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        </StackPanel>
                                                </StackPanel>
                                        </Border>

                                        <!-- Delete Backup Section -->
                                        <Border BorderBrush="#BDC3C7"
                                                BorderThickness="1"
                                                Padding="15"
                                                Margin="0,0,0,15"
                                                CornerRadius="5">
                                                <StackPanel>
                                                        <TextBlock Text="Delete Backup"
                                                                   Style="{StaticResource HeaderTextStyle}"
                                                                   FontSize="14"/>
                                                        <TextBlock Text="Permanently deletes the selected backup from the server."
                                                                   TextWrapping="Wrap"
                                                                   Style="{StaticResource InfoTextStyle}"
                                                                   Margin="0,0,0,10"/>

                                                        <Button Content="🗑️ Delete Backup"
                                                                Command="{Binding DeleteBackupCommand}"
                                                                Style="{StaticResource DangerButtonStyle}"
                                                                HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                        </Border>

                                        <!-- Cancel Operation -->
                                        <Button Content="❌ Cancel Operation"
                                                Command="{Binding CancelOperationCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                HorizontalAlignment="Stretch"
                                                Visibility="{Binding CanCancel, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                                </StackPanel>
                        </GroupBox>
                </Grid>

                <!-- Status Bar -->
                <Border Grid.Row="2"
                        Background="#ECF0F1"
                        BorderBrush="#BDC3C7"
                        BorderThickness="0,1,0,0"
                        Padding="10,8"
                        Margin="-20,20,-20,0">
                        <DockPanel>
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Status: "
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding StatusMessage}"
                                           FontStyle="Italic"/>
                        </DockPanel>
                </Border>

                <!-- Close Button -->
                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,15,0,0">
                        <Button Content="Close"
                                Command="{Binding CloseCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="100"/>
                </StackPanel>
        </Grid>
</Window>