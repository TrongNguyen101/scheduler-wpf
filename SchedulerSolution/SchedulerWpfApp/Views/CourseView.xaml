<UserControl x:Class="SchedulerWpfApp.Views.CourseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SchedulerWpfApp.ViewModel"
             DataContext="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext}"
             Background="White">
    <Grid>
        <StackPanel Margin="20">
            <TextBlock Text="Course Management"
                       FontSize="24"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <!-- List of courses -->
            <ListBox ItemsSource="{Binding Courses}"
                     Margin="0,0,0,20"
                     Height="200"/>

            <!-- Buttons to add and remove courses -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center"
                        >
                <Button Content="Add Course"
                        Command="{Binding AddCourseCommand}"
                        Width="100"/>
                <Button Content="Remove Course"
                        Command="{Binding RemoveCourseCommand}"
                        Width="100"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
