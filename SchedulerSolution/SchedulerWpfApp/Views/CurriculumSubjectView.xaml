<UserControl x:Class="SchedulerWpfApp.Views.CurriculumSubjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:SchedulerWpfApp.ViewModel"
             xmlns:syncfusion="http://schemas.syncfusion.com/wpf"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="White">
    <Grid Background="#f8f9fa">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0"
              Height="40"
              Margin="0,0,0,0">
            <Border Background="{StaticResource PrimaryColor}"
                    CornerRadius="10, 10, 0 , 0">
                <TextBlock Text="Quản Lí Khung Môn Học"
                           FontWeight="Bold"
                           FontSize="22"
                           Foreground="White"
                           VerticalAlignment="Center"
                           HorizontalAlignment="center"
                           Padding="0, 0, 0, 0" />
            </Border>
        </Grid>

        <!-- Main Content -->
        <Grid Grid.Row="1"
              Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Top Controls -->
            <Grid Grid.Row="0"
                  Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Search Box -->
                <Border Background="#EEF2F6"
                        BorderBrush="#D0D0D0"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="10,5"
                        Margin="0,0,10,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="🔍"
                                   FontSize="14"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextColor}"
                                 VerticalAlignment="Center"
                                 Name="SearchBox"
                                 Text="{Binding SearchKeyword, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="0,5">
                            <TextBox.Resources>
                                <Style TargetType="{x:Type TextBox}">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type TextBox}">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ScrollViewer x:Name="PART_ContentHost"
                                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>
                    </Grid>
                </Border>

                <Button Grid.Column="1"
                        Style="{StaticResource ExportButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ExportCurriculumSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📤"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Export Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Import Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource ActionButtonStyle}"
                        Margin="0,0,10,0"
                        Command="{Binding ImportCurriculumSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📥"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Import Dữ Liệu"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>

                <!-- Add Student Button -->
                <Button Grid.Column="3"
                        Style="{StaticResource SuccessButtonStyle}"
                        Command="{Binding AddCurriculumSubjectCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="➕"
                                   VerticalAlignment="Center" />
                        <TextBlock Text=" Thêm Khung Môn Học"
                                   Margin="5,0,0,0"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Syncfusion DataGrid -->
            <Border Grid.Row="1"
                    Background="White"
                    CornerRadius="8"
                    Padding="0">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="1"
                                      BlurRadius="10"
                                      Opacity="0.1"
                                      Color="Gray" />
                </Border.Effect>

                <syncfusion:SfDataGrid x:Name="CurriculumSubjectsDataGrid"
                                       AutoGenerateColumns="False"
                                       AllowFiltering="True"
                                       ShowRowHeader="False"
                                       RowHeight="45"
                                       HeaderRowHeight="50"
                                       SelectionMode="Single"
                                       AllowSorting="True"
                                       GridLinesVisibility="Both"
                                       ItemsSource="{Binding CurriculumSubjects}"
                                       ColumnSizer="Star"
                                       HeaderStyle="{StaticResource GridHeaderStyle}"
                                       CellStyle="{StaticResource GridCellStyle}"
                                       CurrentCellBorderBrush="White">
                    <syncfusion:SfDataGrid.Columns>
                        <syncfusion:GridTextColumn HeaderText="Mã Khung Chương Trình"
                                                   MappingName="CurriculumCode"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Mã Môn Học"
                                                   MappingName="SubjectCode"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tên Môn"
                                                   MappingName="SubjectNameEnglish"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tên Môn Tiếng Việt"
                                                   MappingName="SubjectNameVietnamese"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Kỳ"
                                                   MappingName="TermNo"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Combo"
                                                   MappingName="IsCombo"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tổng Tín Chỉ"
                                                   MappingName="Credit"
                                                   AllowResizing="True" />
                        <syncfusion:GridTextColumn HeaderText="Tổng Slot"
                                                   MappingName="TotalSlots"
                                                   AllowResizing="True" />
                        <syncfusion:GridTemplateColumn HeaderText="Actions"
                                                       Width="90"
                                                       AllowFiltering="False"
                                                       MappingName="ActionPlaceholder">
                            <syncfusion:GridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal"
                                                HorizontalAlignment="Center">
                                        <Button Style="{StaticResource EditButtonStyle}"
                                                Command="{Binding DataContext.EditCurriculumSubjectCommand, RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="✏️"
                                                       TextAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                        <Button Style="{StaticResource DeleteButtonStyle}"
                                                Command="{Binding DataContext.DeleteCurriculumSubjectCommand,  RelativeSource={RelativeSource AncestorType=syncfusion:SfDataGrid}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Text="🗑️"
                                                       TextAlignment="Center"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </syncfusion:GridTemplateColumn.CellTemplate>
                        </syncfusion:GridTemplateColumn>
                    </syncfusion:SfDataGrid.Columns>
                </syncfusion:SfDataGrid>
            </Border>

            <!-- Pagination Controls -->
            <Grid Grid.Row="2"
                  Margin="0,15,0,0"
                  HorizontalAlignment="Right"
                  Width="760">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Pagination -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal">
                    <syncfusion:SfDataPager x:Name="dataPager"
                                            PageSize="10"
                                            NumericButtonCount="5"
                                            PagedSource="{Binding CurriculumSubjects}" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- CurriculumSubject Form Popup -->
        <Popup x:Name="CurriculumSubjectFormPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsCurriculumSubjectFormOpen}"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="25"
                    Width="500">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="15"
                                      Opacity="0.2"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Form Header -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,20">
                        <TextBlock x:Name="formTitle"
                                   Text="{Binding Title}"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextColor}" />
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Grid.Row="1"
                                Margin="0,0,0,20">
                        <TextBlock Text="Mã Khung Chương Trình"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <ComboBox SelectedItem="{Binding SelectedCurriculumCode, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AllCurriculumCodes}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Background="#F5F5F5"
                                  Margin="0,0,0,15" />

                        <TextBlock Text="Mã Môn Học"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <ComboBox SelectedItem="{Binding SelectedSubjectCode, UpdateSourceTrigger=PropertyChanged}"
                                  ItemsSource="{Binding AllSubjectCodes}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  Background="#F5F5F5"
                                  Margin="0,0,0,15" />

                        <TextBlock Text="Tên Môn Tiếng Anh"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.SubjectNameEnglish, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F5F5F5"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="Tên Môn Tiếng Việt"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedSubject.SubjectNameVietnamese, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}"
                                 IsReadOnly="True"
                                 Background="#F5F5F5"
                                 Margin="0,0,0,15" />

                        <TextBlock Text="Kỳ"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedCurriculumSubject.TermNo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" />

                        <TextBlock Text="Combo"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <ComboBox SelectedValue="{Binding SelectedCurriculumSubject.IsCombo, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ModernComboBoxStyle}"
                                  SelectedValuePath="Tag"
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="Yes"
                                          Tag="{x:Static sys:Boolean.TrueString}" />
                            <ComboBoxItem Content="No"
                                          Tag="{x:Static sys:Boolean.FalseString}" />
                        </ComboBox>

                        <TextBlock Text="Tín Chỉ"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedCurriculumSubject.Credit, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" />

                        <TextBlock Text="Tổng Slot"
                                   Margin="0,0,0,5"
                                   Foreground="{StaticResource TextColor}" />
                        <TextBox Text="{Binding SelectedCurriculumSubject.TotalSlots, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBoxStyle}" />
                    </StackPanel>

                    <!-- Form Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Hủy"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#95a5a6"
                                Margin="0,0,10,0"
                                Padding="20,8"
                                Command="{Binding CancelEditCurriculumSubjectCommand}" />

                        <Button Grid.Column="2"
                                x:Name="btnSaveStudent"
                                Content="Lưu"
                                Style="{StaticResource SuccessButtonStyle}"
                                Padding="20,8"
                                Command="{Binding SaveCurriculumSubjectCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>

        <!-- Confirmation Dialog -->
        <Popup x:Name="confirmationPopup"
               StaysOpen="False"
               Placement="Center"
               IsOpen="{Binding IsOpenDialog}"
               AllowsTransparency="True">
            <Border Background="White"
                    BorderThickness="0"
                    CornerRadius="8"
                    Padding="25"
                    Width="400">
                <Border.Effect>
                    <DropShadowEffect ShadowDepth="2"
                                      BlurRadius="15"
                                      Opacity="0.2"
                                      Color="Black" />
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Dialog Header -->
                    <TextBlock Grid.Row="0"
                               Text="Xác nhận xóa"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,0,0,15" />

                    <!-- Dialog Content -->
                    <TextBlock Grid.Row="1"
                               Text="Bạn có chắc chắn muốn xóa môn học này không?"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource TextColor}"
                               Margin="0,0,0,20" />

                    <!-- Dialog Actions -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                Content="Hủy"
                                Style="{StaticResource ActionButtonStyle}"
                                Background="#95a5a6"
                                Margin="0,0,10,0"
                                Padding="20,8"
                                Command="{Binding CancelDeleteCurriculumSubjectCommand}" />

                        <Button Grid.Column="2"
                                Content="Xóa"
                                Style="{StaticResource DeleteButtonStyle}"
                                Padding="20,8"
                                Command="{Binding ConfirmDeleteCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Popup>
    </Grid>
</UserControl>
