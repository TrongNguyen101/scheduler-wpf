<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Updated Colors - Modern & Professional Color Scheme -->
    <SolidColorBrush x:Key="PrimaryColor"
                     Color="#4285F4"/>
    <!-- Google Blue -->
    <SolidColorBrush x:Key="PrimaryColorDark"
                     Color="#3367D6"/>
    <!-- Darker shade for hover -->
    <SolidColorBrush x:Key="AccentColor"
                     Color="#FF9800"/>
    <!-- Orange -->
    <SolidColorBrush x:Key="AccentColorDark"
                     Color="#F57C00"/>
    <!-- Darker Orange -->
    <SolidColorBrush x:Key="TextColor"
                     Color="#202124"/>
    <!-- Dark Gray -->
    <SolidColorBrush x:Key="LightTextColor"
                     Color="#5F6368"/>
    <!-- Medium Gray -->
    <SolidColorBrush x:Key="ErrorColor"
                     Color="#EA4335"/>
    <!-- Google Red -->
    <SolidColorBrush x:Key="ErrorColorDark"
                     Color="#D32F2F"/>
    <!-- Darker Red -->
    <SolidColorBrush x:Key="SuccessColor"
                     Color="#34A853"/>
    <!-- Google Green -->
    <SolidColorBrush x:Key="SuccessColorDark"
                     Color="#2E7D32"/>
    <!-- Darker Green -->
    <SolidColorBrush x:Key="BackgroundColor"
                     Color="#F8F9FA"/>
    <!-- Light Gray -->
    <SolidColorBrush x:Key="CancelColor"
                     Color="#757575"/>
    <!-- Medium Gray -->
    <SolidColorBrush x:Key="CancelColorDark"
                     Color="#616161"/>
    <!-- Darker Gray -->
    <SolidColorBrush x:Key="HeaderBackground"
                     Color="#EEF2F6"/>
    <!-- Light Blue-Gray -->
    <SolidColorBrush x:Key="SearchBackground"
                     Color="#FFFFFF"/>
    <!-- White -->
    <SolidColorBrush x:Key="SearchBorder"
                     Color="#DADCE0"/>
    <!-- Light Gray Border -->
</ResourceDictionary>
