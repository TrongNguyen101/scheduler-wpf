<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:SchedulerWpfApp.ViewModel"
                    xmlns:views="clr-namespace:SchedulerWpfApp.Views" 
                    xmlns:converters="clr-namespace:SchedulerWpfApp.Helper">

    <!-- DataTemplate for CourseView -->
    <DataTemplate DataType="{x:Type vm:SubjectViewModel}">
        <views:SubjectView/>
    </DataTemplate>

    <!-- DataTemplate for RoomView -->
    <DataTemplate DataType="{x:Type vm:GroupNameViewModel}">
        <views:GroupNameView/>
    </DataTemplate>

    <!-- DataTemplate for RoomView -->
    <DataTemplate DataType="{x:Type vm:RoomViewModel}">
        <views:RoomView />
    </DataTemplate>

    <!-- DataTemplate for CreateScheduleView -->
    <DataTemplate DataType="{x:Type vm:CreateScheduleViewModel}">
        <views:CreateScheduleView/>
    </DataTemplate>

    <!-- DataTemplate for LectureView -->
    <DataTemplate DataType="{x:Type vm:LectureViewModel}">
        <views:LectureView />
    </DataTemplate>

    <!-- DataTemplate for LectureSubjectView -->
    <DataTemplate DataType="{x:Type vm:LecturerSubjectViewModel}">
        <views:LecturerSubjectView/>
    </DataTemplate>

    <!-- DataTemplate for CurriculumView -->
    <DataTemplate DataType="{x:Type vm:CurriculumViewModel}">
        <views:CurriculumView />
    </DataTemplate>

    <!-- DataTemplate for CurriculumSubjectView -->
    <DataTemplate DataType="{x:Type vm:CurriculumSubjectViewModel}">
        <views:CurriculumSubjectView />
    </DataTemplate>

    <converters:IntToStringConverter x:Key="IntToStringConverter" />
</ResourceDictionary>
